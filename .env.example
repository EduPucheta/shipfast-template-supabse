# Copy to .env.local (Next.js) or export in your environment

# OpenAI
OPENAI_API_KEY=

# Cron auth for /api/cron/* routes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Supabase (optional for unrelated features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional for /api/send)
RESEND_API_KEY=